<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BlurMask"
             x:Class="BlurMask.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/BlurMask.ico"
                ToolTipText="{x:Static local:UiText.TrayTooltip}"
                IsVisible="True"
                Clicked="TrayOnClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{x:Static local:UiText.DrawOnDesktop}" Click="DrawingOnClicked" />
            <NativeMenuItem Header="{x:Static local:UiText.NewMask}" Click="NewMaskOnClicked" />
            <NativeMenuItem Header="{x:Static local:UiText.CloseMask}" Click="CloseMaskOnClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static local:UiText.ExitApp}" Click="ExitOnClicked" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
