# Packages the existing Ubuntu 22.04 Native AOT payload; no .NET SDK/runtime needed.
pkgname=novapen
# Rename transition: a local pacman -U must also refuse co-installation.
conflicts=('blurmask')
replaces=('blurmask')
pkgver=${BLURMASK_VERSION:-1.0.0}
pkgrel=1
pkgdesc='Native desktop annotation, privacy masks and shared canvas'
arch=('x86_64')
url='https://github.com/Xekep/NovaPen'
license=('MIT' 'GPL-3.0-or-later')
depends=('glibc>=2.35' 'gcc-libs' 'zlib' 'openssl' 'icu' 'ca-certificates'
         'libx11' 'libxcb' 'libice' 'libsm' 'fontconfig' 'libxcursor'
         'libxrandr' 'libxi' 'libxrender' 'dbus' 'wayland' 'libxkbcommon' 'libglvnd')
optdepends=('xorg-xwayland: run in a Wayland desktop session')
backup=('etc/xdg/autostart/blurmask.desktop')
# The payload is already stripped; never alter the tested native binaries.
options=('!strip' '!debug')
source=('payload.tar' 'novapen.desktop' 'novapen.svg' 'LICENSE')
# tools/build-arch.sh appends the SHA-256 of every local input before makepkg.

package() {
  install -d "$pkgdir/opt/novapen" "$pkgdir/usr/bin"
  cp -a "$srcdir/payload/." "$pkgdir/opt/novapen/"
  chmod 755 "$pkgdir/opt/novapen/NovaPen"
  chmod 755 "$pkgdir/opt/novapen/runtimes/linux-x64/solver/icas"
  ln -s /opt/novapen/NovaPen "$pkgdir/usr/bin/novapen"
  install -Dm644 "$srcdir/novapen.desktop" "$pkgdir/usr/share/applications/novapen.desktop"
# Keep the XDG autostart ID stable: preserve disabled user overrides and replace the old conffile.
  install -Dm644 "$srcdir/novapen.desktop" "$pkgdir/etc/xdg/autostart/blurmask.desktop"
  sed -i 's|^Exec=/opt/novapen/NovaPen$|Exec=/opt/novapen/NovaPen --minimized|' "$pkgdir/etc/xdg/autostart/blurmask.desktop"
  install -Dm644 "$srcdir/novapen.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/novapen.svg"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/novapen/LICENSE"
}
