<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BlurMask</AssemblyName>
    <RootNamespace>BlurMask</RootNamespace>

    <!-- Native AOT is the release/deployment model for this app. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Windows AOT links the rendering libraries into the executable. -->
    <StaticNativeLibraries Condition="'$(StaticNativeLibraries)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(PublishAot)' == 'true'">true</StaticNativeLibraries>

    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\BlurMask.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="StaticLink.Avalonia" Version="3.119.4-7922.1" Condition="'$(StaticNativeLibraries)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="server/**" />
    <EmbeddedResource Remove="server/**" />
    <None Remove="server/**" />
  </ItemGroup>

  <Target Name="RemoveNativeDebugSymbols" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_NativeDebugSymbols Include="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)libHarfBuzzSharp.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativeDebugSymbols)" />
  </Target>
</Project>
