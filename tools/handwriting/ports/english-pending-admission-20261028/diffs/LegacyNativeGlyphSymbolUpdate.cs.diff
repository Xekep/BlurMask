@@ -32,4 +32,30 @@
         pool.ReplaceRecord(reference, record, cancellationToken);
         return true;
     }
+
+    // Same scalar producer as public Apply; only its two record accesses use
+    // the already issued numeric batch. Public/default Apply stays byte-exact.
+    internal static bool ApplyUsingBatch(LegacyNativeGlyphRecordPool pool,LegacyNativeGlyphRecordPool.DescriptorBatch batch,ulong reference,
+        ushort symbol,int componentCount,byte componentFlag,bool externalVariant,CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(pool);
+        cancellationToken.ThrowIfCancellationRequested();
+        byte[] record = batch.CopyRecord(pool, reference, cancellationToken);
+        ushort kind;
+        if (externalVariant) kind = 4;
+        else if (componentCount == 0) { kind = 1; symbol = 1; }
+        else if (symbol is >= 0xfff9 and <= 0xfffc)
+        {
+            if (componentCount >= 8192) return false;
+            ushort packed = unchecked((ushort)((componentFlag << 13) | (componentCount & 0x1fff)));
+            symbol = unchecked((ushort)((packed << 2) | ((symbol - 1) & 3)));
+            kind = 1;
+        }
+        else kind = 0;
+        ushort flags = BinaryPrimitives.ReadUInt16LittleEndian(record.AsSpan(4));
+        BinaryPrimitives.WriteUInt16LittleEndian(record.AsSpan(4), (ushort)((flags & 0xfff8) | kind));
+        BinaryPrimitives.WriteUInt16LittleEndian(record.AsSpan(8), symbol);
+        batch.ReplaceRecord(pool, reference, record, cancellationToken);
+        return true;
+    }
 }
