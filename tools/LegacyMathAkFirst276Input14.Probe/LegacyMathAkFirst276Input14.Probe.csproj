<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>LegacyMathAkFirst276Program.Probe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType><DebugSymbols>true</DebugSymbols><Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /></ItemGroup>
  <ItemGroup Condition="'$(ReviewedLibraryPath)' == ''">
    <ProjectReference Include="../../src/InkRecognition/InkRecognition.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReviewedLibraryPath)' != ''">
    <Reference Include="InkRecognition"><HintPath>$(ReviewedLibraryPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
